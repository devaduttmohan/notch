{
  "manifest_version": 3,
  "name": "Notch Now Playing",
  "version": "0.4.0",
  "description": "Shows what's playing in Chrome in the Notch app on this Mac.",
  "minimum_chrome_version": "116",
  "permissions": ["scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
