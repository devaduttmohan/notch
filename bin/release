#!/bin/bash
# Publishes a new version of Notch, start to finish:
#
#   bin/release 0.7.2                 notes from build/release/notes-0.7.2.md
#   bin/release 0.7.2 path/to/notes.md
#   bin/release 0.7.2 --no-install   leave this Mac's copy alone (to try the in-app update)
#
#   1. checks: clean main, notes there, no v0.7.2 tag or release yet (here or on GitHub)
#   2. sets the version in Resources/Info.plist (build number + 1), builds Notch.app, zips it,
#      unzips the zip and checks it (signature, version, notchctl inside). Anything wrong here:
#      Info.plist is put back and nothing is committed or pushed.
#   3. commits "Version 0.7.2" and pushes it
#   4. uploads the GitHub release as a draft (the notes, the zip, the Chrome extension zip),
#      waits for GitHub's checksum of the zip (up to DIGEST_WAIT s, default 60), checks it
#      matches, and only then publishes it, tagged on the commit that was built
#   5. updates the Homebrew cask (packaging/homebrew/notch.rb) in the tap and pushes it
#      (TAP_DIR, default ../homebrew-tap; skipped with a note if it isn't there)
#   6. reinstalls the new version here (bin/notch), unless --no-install
#
# Needs a clean main branch and gh signed in (gh auth status). If it stops after step 3 and
# before the release is uploaded (say the network dropped), run it again with the same version:
# it sees the version is already set and carries on from the build. If a draft was uploaded,
# delete it first (it says so); once the release is published, finish the cask by hand.
# CO_AUTHOR="Name <email>" adds a Co-Authored-By line to the commits it makes.
set -euo pipefail
cd "$(dirname "$0")/.."
ROOT="$PWD"
INSTALL=1; POSITIONAL=()
for arg in "$@"; do
  case "$arg" in
    --no-install) INSTALL=0 ;;
    *) POSITIONAL+=("$arg") ;;
  esac
done
VERSION="${POSITIONAL[0]:?usage: bin/release <version> [notes.md] [--no-install]}"
NOTES="${POSITIONAL[1]:-build/release/notes-$VERSION.md}"
TRAILER=(); [ -n "${CO_AUTHOR:-}" ] && TRAILER=(-m "Co-Authored-By: $CO_AUTHOR")
TAP_DIR="${TAP_DIR:-$ROOT/../homebrew-tap}"
PLIST="Resources/Info.plist"
REPO="$(/usr/libexec/PlistBuddy -c "Print :NotchUpdateRepo" "$PLIST")"
ZIP="build/release/Notch-$VERSION.zip"

# 1. Checks
[[ "$VERSION" =~ ^[0-9]+(\.[0-9]+)+$ ]] || { echo "Version should look like 0.7.2, not $VERSION"; exit 1; }
[ -f "$NOTES" ] || { echo "No release notes at $NOTES"; exit 1; }
[ "$(git branch --show-current)" = main ] || { echo "Releases come from main"; exit 1; }
[ -z "$(git status --porcelain)" ] || { echo "Commit or stash your changes first"; exit 1; }
git rev-parse -q --verify "refs/tags/v$VERSION" >/dev/null && { echo "v$VERSION already exists here"; exit 1; }
git ls-remote --exit-code --tags origin "refs/tags/v$VERSION" >/dev/null 2>&1 && { echo "v$VERSION already exists on GitHub"; exit 1; }
# Drafts included (only the GitHub API lists them, to the repo's owners). A gh failure stops
# here rather than reading as "no release".
RELEASES_QUERY=".[] | select(.tag_name == \"v$VERSION\") | .id"
EXISTING="$(gh api "repos/$REPO/releases?per_page=30" --jq "$RELEASES_QUERY")" \
  || { echo "Couldn't ask GitHub about releases (is gh signed in? gh auth status)"; exit 1; }
[ -z "$EXISTING" ] || { echo "A v$VERSION release (or draft) already exists; delete it first if it's a leftover"; exit 1; }
CURRENT="$(/usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" "$PLIST")"
BUILD="$(/usr/libexec/PlistBuddy -c "Print :CFBundleVersion" "$PLIST")"

# Until the version is committed, any failure puts Info.plist back; the check folder always goes.
COMMITTED=0
CHECK="$(mktemp -d)"
cleanup() {
  rm -rf "${CHECK:?}"
  if [ "$COMMITTED" = 0 ] && [ -n "$(git status --porcelain -- "$PLIST")" ]; then
    git checkout HEAD -- "$PLIST"                      # index and file both (a failed commit may have staged it)
    echo "Stopped before committing: $PLIST put back, nothing pushed"
  fi
}
trap cleanup EXIT

# 2. The version, and the app zipped and checked the way a user (or the in-app updater) gets it
if [ "$CURRENT" = "$VERSION" ]; then
  COMMITTED=1
  echo "Notch $VERSION is already the version here (build $BUILD): carrying on from the build"
else
  echo "Releasing Notch $VERSION (was $CURRENT, build $BUILD → $((BUILD + 1))) to $REPO"
  /usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $VERSION" -c "Set :CFBundleVersion $((BUILD + 1))" "$PLIST"
fi
BUILT="$(bin/notch --build-only 2>&1)" || { echo "$BUILT" | tail -25; exit 1; }
mkdir -p build/release
rm -f "$ZIP"
ditto -c -k --sequesterRsrc --keepParent build/Notch.app "$ZIP"
ditto -x -k "$ZIP" "$CHECK"
codesign --verify --deep --strict "$CHECK/Notch.app"
# The in-app updater only takes an app signed as Notch (not a one-off ad-hoc signature).
codesign -d -r- "$CHECK/Notch.app" 2>&1 | grep -q 'identifier "dev.notch.Notch"' \
  || { echo "The app isn't signed as Notch (identifier requirement), so updaters would refuse it"; exit 1; }
[ "$(/usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" "$CHECK/Notch.app/Contents/Info.plist")" = "$VERSION" ] \
  || { echo "The zipped app isn't $VERSION"; exit 1; }
[ -x "$CHECK/Notch.app/Contents/MacOS/notchctl" ] || { echo "notchctl is missing from the app"; exit 1; }
# Apple silicon, as the cask says and the updater checks (a build under Rosetta would be Intel-only).
file -b "$CHECK/Notch.app/Contents/MacOS/Notch" | grep -qw "arm64" \
  || { echo "The app isn't built for Apple silicon (arm64); build it outside Rosetta"; exit 1; }
SHA="$(shasum -a 256 "$ZIP" | cut -d' ' -f1)"
echo "Zip checked: $ZIP ($(du -h "$ZIP" | cut -f1 | xargs)), sha256 $SHA"

# 3. Commit and push the version
if [ "$COMMITTED" = 0 ]; then
  git add "$PLIST"
  git commit -q -m "Version $VERSION" ${TRAILER[@]+"${TRAILER[@]}"}
  COMMITTED=1
fi
git push -q origin main

# 4. The GitHub release: a draft until GitHub's checksum for the zip matches ours. The in-app
# updater only installs a zip GitHub has a checksum for, so no checksum means no publishing.
# The tag goes on the commit that was built, not on whatever main is by then.
EXTENSION="$(ls -t build/release/Notch-Chrome-extension-*.zip 2>/dev/null | head -1 || true)"
gh release create "v$VERSION" --repo "$REPO" --target "$(git rev-parse HEAD)" --draft --title "Notch $VERSION" \
  --notes-file "$NOTES" "$ZIP" ${EXTENSION:+"$EXTENSION"} >/dev/null
DRAFT="left as a draft: check it on GitHub, then publish it or delete it and run this again"
NO_DIGEST="left as a draft: delete it on GitHub and run this again (don't publish it: the in-app updater can't install a zip without GitHub's checksum)"
MISMATCH="left as a draft: delete it on GitHub and run this again (don't publish it: it isn't the zip that was built and checked)"
# GitHub calls after the upload get three tries, so one network blip doesn't strand the draft.
# Only the attempt that worked is printed (a failed one may print an error body).
retry() {
  local tries=0 out
  until out="$("$@")"; do tries=$((tries + 1)); [ "$tries" -lt 3 ] || return 1; sleep 3; done
  printf '%s\n' "$out"
}
draft_id() {                                                     # empty (not listed yet) counts as a failure
  local id; id="$(gh api "repos/$REPO/releases?per_page=30" --jq "$RELEASES_QUERY" | head -1)" && [ -n "$id" ] && printf '%s\n' "$id"
}
ID="$(retry draft_id)" || { echo "Couldn't read the release back; $DRAFT"; exit 1; }
[ -n "$ID" ] || { echo "Couldn't find the draft release just made; $DRAFT"; exit 1; }
ASSET_QUERY=".assets[] | select(.name == \"Notch-$VERSION.zip\")"
PUBLISHED=""; WAITED=0
while [ -z "$PUBLISHED" ] && [ "$WAITED" -le "${DIGEST_WAIT:-60}" ]; do
  [ "$WAITED" = 0 ] || sleep 5
  PUBLISHED="$(retry gh api "repos/$REPO/releases/$ID" --jq "$ASSET_QUERY | .digest // empty" | sed 's/^sha256://')" \
    || { echo "Couldn't read the draft's zip back; $DRAFT"; exit 1; }
  WAITED=$((WAITED + 5))
done
[ -n "$PUBLISHED" ] || { echo "GitHub hasn't recorded a checksum for the zip, and the in-app updater needs one; $NO_DIGEST"; exit 1; }
[ "$PUBLISHED" = "$SHA" ] || { echo "GitHub's checksum ($PUBLISHED) doesn't match the zip ($SHA); $MISMATCH"; exit 1; }
if ! retry gh api -X PATCH "repos/$REPO/releases/$ID" -F draft=false -f make_latest=true >/dev/null; then
  # The answer may have been lost after GitHub applied it: look before saying it's still a draft.
  [ "$(gh api "repos/$REPO/releases/$ID" --jq '.draft' 2>/dev/null || echo true)" = false ] \
    || { echo "Couldn't publish the release; $DRAFT"; exit 1; }
fi
echo "Published: https://github.com/$REPO/releases/tag/v$VERSION"

# 5. The Homebrew cask
if [ -d "$TAP_DIR/.git" ]; then
  mkdir -p "$TAP_DIR/Casks"
  sed -e "s/VERSION/$VERSION/" -e "s/SHA256/$SHA/" packaging/homebrew/notch.rb > "$TAP_DIR/Casks/notch.rb"
  git -C "$TAP_DIR" add Casks/notch.rb
  git -C "$TAP_DIR" commit -q -m "notch $VERSION" ${TRAILER[@]+"${TRAILER[@]}"}
  git -C "$TAP_DIR" push -q origin HEAD
  echo "Cask updated: notch $VERSION"
else
  echo "No tap at $TAP_DIR: the Homebrew cask wasn't updated (set TAP_DIR to your homebrew-tap checkout)"
fi

# 6. This Mac
if [ "$INSTALL" = 1 ]; then bin/notch --no-log >/dev/null; else echo "Left this Mac's copy as it was (--no-install)"; fi
echo "Released: https://github.com/$REPO/releases/tag/v$VERSION"
